# Copy this to .env and fill in your values
# Never commit .env to version control

# VirusTotal API key (optional — VT checks are skipped if unset)
VIRUSTOTAL_API_KEY=dec5b0be27a974de2bf865418fd45eedee59cff66ca0511d33c6fd2029e054e2

# API key required on all requests via X-API-Key header
# Generate a strong random value: openssl rand -hex 32
TRUSTGUARD_API_KEY=change_me_to_a_strong_random_secret

# Rate limiting (requests per minute per IP)
RATE_LIMIT=60

# Phase 6: Canary Rollout Configuration
CANARY_TRAFFIC_PCT=0.05
CANARY_MIN_REQUESTS=1000
